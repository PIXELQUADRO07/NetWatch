const fmtBs = b => { if (!b) return "0 B/s"; if (b>=1e6) return (b/1e6).toFixed(2)+" MB/s"; if (b>=1e3) return (b/1e3).toFixed(1)+" KB/s"; return Math.round(b)+" B/s"; };
