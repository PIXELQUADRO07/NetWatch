const FLAG  = cc => ({US:"🇺🇸",DE:"🇩🇪",NL:"🇳🇱",AU:"🇦🇺",GB:"🇬🇧",FR:"🇫🇷",JP:"🇯🇵",IT:"🇮🇹",SG:"🇸🇬",CA:"🇨🇦",CN:"🇨🇳",RU:"🇷🇺"})[cc] || "🌐";

