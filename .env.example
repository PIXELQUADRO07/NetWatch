# ─────────────────────────────────────────────────────────────────────────────
# NetWatch v4 — Environment Variables
# Copy to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend ──────────────────────────────────────────────────────────────────

# Port the Flask server listens on
NETWATCH_PORT=5000

# Path to the SQLite database file (auto-created on first run)
NETWATCH_DB=/data/netwatch.db

# Network interface to capture on (leave empty for auto-detection)
# Examples: eth0, enp3s0, wlan0, en0
NETWATCH_INTERFACE=

# Set to "true" to run with synthetic demo data (no root/pcap needed)
NETWATCH_DEMO=false

# ── Authentication ───────────────────────────────────────────────────────────

# JWT signing secret — CHANGE THIS in production!
NETWATCH_SECRET_KEY=change-me-in-production-use-a-long-random-string

# Default admin credentials (change after first login!)
NETWATCH_ADMIN_USER=admin
NETWATCH_ADMIN_PASS=netwatch

# JWT token lifetime in seconds (default: 24h)
NETWATCH_JWT_EXPIRY=86400

# Set to "false" to disable authentication entirely (dev/trusted network only)
NETWATCH_AUTH_ENABLED=true

# ── Logging ──────────────────────────────────────────────────────────────────

# Log level: DEBUG | INFO | WARNING | ERROR
NETWATCH_LOG_LEVEL=INFO

# Log format: auto | json | text
# auto = JSON in non-TTY (Docker/production), text with colors in TTY
NETWATCH_LOG_FORMAT=auto

# ── Frontend ─────────────────────────────────────────────────────────────────

# Port the Nginx frontend is exposed on (Docker Compose only)
NETWATCH_UI_PORT=8080

# Backend API base URL used at Vite build time
# In Docker: handled automatically by nginx proxy, leave as default
# For custom deployments: set to your backend URL
VITE_API_BASE=http://localhost:5000/api
